# Copy to .env and replace every placeholder before running Docker Compose.
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://tlschat:replace-with-a-url-safe-password@postgres:5432/tlschat

# Optional production integrations
FILE_STORAGE_MODE=local
S3_BUCKET=
S3_REGION=us-east-1
S3_PREFIX=tls-chat/
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
REGISTRAR_USERNAME=
REGISTRAR_PASSWORD=
ADMIN_USERNAME=
ADMIN_PASSWORD=
CLOUDFLARE_TUNNEL_TOKEN=
